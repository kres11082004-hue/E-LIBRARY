{
  "name": "e-library",
  "framework": "vite",
  "buildCommand": "pnpm --filter @workspace/elibrary run build",
  "outputDirectory": "artifacts/elibrary/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api|uploads).*)",
      "destination": "/index.html"
    }
  ]
}
