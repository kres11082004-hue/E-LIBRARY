{
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/elibrary/dist/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/uploads/(.*)", "destination": "/api/uploads/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
