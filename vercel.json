{
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/elibrary run build",
  "outputDirectory": "artifacts/elibrary/dist/public",

  "env": {
    "NODE_ENV": "production",
    "VITE_API_BASE_URL": "https://e-library-2c03.onrender.com"
  },

  "rewrites": [
    {
      "source": "/((?!assets|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}