{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/elibrary run build",
  "outputDirectory": "artifacts/elibrary/dist/public",

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|uploads|assets|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}