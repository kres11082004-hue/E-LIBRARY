DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/e-library_db
SESSION_SECRET=dev_session_secret_key_987654321
API_PORT=8080
FRONTEND_PORT=19545
BASE_PATH=/
SANDBOX_PORT=8081
NODE_ENV=development

# ── Email (Nodemailer / SMTP) ─────────────────────────────────────────────────
# Gmail example: use an App Password (not your regular Gmail password)
# Go to: Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="ZDSPGC E-Library <your-email@gmail.com>"

# ── SMS (Twilio) ──────────────────────────────────────────────────────────────
# Sign up at https://www.twilio.com — free trial gives a test number
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ── Scheduler cron overrides (optional) ──────────────────────────────────────
# REMINDER_CRON=0 * * * *      # default: every hour
# OVERDUE_CRON=*/30 * * * *    # default: every 30 min
